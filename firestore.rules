rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin users logged in via verified Google Auth: customerservice.mme365@gmail.com, marketingmanagementenp.365@gmail.com
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email == 'customerservice.mme365@gmail.com'
          || request.auth.token.email == 'marketingmanagementenp.365@gmail.com'
          || (request.auth.token.email != null && (
            request.auth.token.email.lower() == 'customerservice.mme365@gmail.com'
            || request.auth.token.email.lower() == 'marketingmanagementenp.365@gmail.com'
          ))
        );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'tier', 'downloadsUsed', 'downloadsLimit'])
        && data.id is string && data.id.size() <= 128 && (data.id == request.auth.uid || isAdmin())
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 128
        && data.tier in ['free', 'creator', 'enterprise', 'pack']
        && data.downloadsUsed is number && data.downloadsUsed >= 0
        && data.downloadsLimit is number && data.downloadsLimit >= 0
        && (!('billingCycle' in data) || data.billingCycle in ['monthly', 'annual'])
        && (!('cycleResetDate' in data) || (data.cycleResetDate is string && data.cycleResetDate.size() <= 64))
        && (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 64))
        && (!('totalVideosProcessed' in data) || data.totalVideosProcessed is number)
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1024))
        && (!('authProvider' in data) || data.authProvider in ['google', 'local', 'password']);
    }

    function isValidYouTubeEngineConfig(data) {
      return data.keys().hasAll(['updatedAt', 'updatedBy'])
        && data.keys().hasOnly([
          'updatedAt',
          'updatedBy',
          'extractorProvider',
          'extractorUrl',
          'extractorApiKey',
          'extractorHostHeader',
          'proxyUrl',
          'cookiesTxt',
          'oauthCredentials',
          'oauthPool'
        ])
        && data.updatedAt == request.time
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 256
        && data.updatedBy.lower() == request.auth.token.email.lower()
        && (!('extractorProvider' in data) || (data.extractorProvider is string && data.extractorProvider.size() <= 64 && data.extractorProvider in ['none', 'cobalt', 'rapidapi_yt_media', 'custom_json']))
        && (!('extractorUrl' in data) || (data.extractorUrl is string && data.extractorUrl.size() <= 1024))
        && (!('extractorApiKey' in data) || (data.extractorApiKey is string && data.extractorApiKey.size() <= 1024))
        && (!('extractorHostHeader' in data) || (data.extractorHostHeader is string && data.extractorHostHeader.size() <= 256))
        && (!('proxyUrl' in data) || (data.proxyUrl is string && data.proxyUrl.size() <= 1024))
        && (!('cookiesTxt' in data) || (data.cookiesTxt is string && data.cookiesTxt.size() <= 200000))
        && (!('oauthCredentials' in data) || (data.oauthCredentials is map && data.oauthCredentials.size() <= 20))
        && (!('oauthPool' in data) || (
          data.oauthPool is list
          && data.oauthPool.size() <= 5
          && (data.oauthPool.size() == 0 || (
            data.oauthPool[0] is map
            && data.oauthPool[0].id is string
            && data.oauthPool[0].id.size() <= 64
            && data.oauthPool[0].credentials is map
          ))
        ));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if (isSignedIn() && resource.data.id == request.auth.uid) || isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /system_config/{configId} {
      allow get: if isValidId(configId) && configId == 'youtube_engine' && isAdmin();
      allow list: if false;
      allow create: if isValidId(configId) && configId == 'youtube_engine' && isAdmin() && isValidYouTubeEngineConfig(incoming());
      allow update: if isValidId(configId) && configId == 'youtube_engine' && isAdmin() && isValidYouTubeEngineConfig(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'updatedAt',
          'updatedBy',
          'extractorProvider',
          'extractorUrl',
          'extractorApiKey',
          'extractorHostHeader',
          'proxyUrl',
          'cookiesTxt',
          'oauthCredentials',
          'oauthPool'
        ]);
      allow delete: if isValidId(configId) && configId == 'youtube_engine' && isAdmin();
    }
  }
}
